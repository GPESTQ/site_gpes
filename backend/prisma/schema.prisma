generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enumerador do cargo da pessoa
enum PersonRole {
  coordinator
  professor
  student
  alumni
  collaborator
}

// Enumerador da descrição da pessoa
enum PersonOccupation {
  researcher
  frontend_developer
  backend_developer
  fullstack_developer
  software_engineer
  designer
}

// Entidade pessoa
model Person {
  id         String           @id @default(cuid())
  name       String
  role       PersonRole
  occupation PersonOccupation
  photoUrl   String?
  links      Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  papers PaperAuthor[]
  projects ProjectMember[]

  @@map("persons")
}

// Entidade admin (usuário que loga no painel administrativo)
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admins")
}

// Entidade publicação
model Paper {
  id            String        @id @default(cuid())
  title         String
  abstract      String
  publishedAt   DateTime
  type          PaperType
  eventJournal  String
  keywords      String
  doi           String?
  pdfUrl        String?
  authors       PaperAuthor[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("papers")
}

// Entidade publicação_autor
model PaperAuthor {
  id       String @id @default(cuid())
  paper    Paper  @relation(fields: [paperId], references: [id], onDelete: Cascade)
  paperId  String
  person   Person @relation(fields: [personId], references: [id])
  personId String
  order    Int

  @@unique([paperId, personId])
  @@map("paper_authors")
}

// Enumerador do tipo de publicação
enum PaperType {
  article
  proceedings
}

// Entidade projeto
model Project {
  id          String          @id @default(cuid())
  title       String
  description String
  methodology String?
  status      ProjectType
  client      String?
  partnerId   String?
  partner     Partner?        @relation(fields: [partnerId], references: [id])
  startedDate DateTime
  endedDate   DateTime?
  members     ProjectMember[]
  images      ProjectImage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("projects")
}

// Entidade projeto_pessoa
model ProjectMember {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  person    Person  @relation(fields: [personId], references: [id])
  personId  String
  order     Int

  @@unique([projectId, personId])
  @@map("project_members")
}

// Enumerador do status do projeto
enum ProjectType {
  inProcess
  completed
}

// Entidade projeto_imagem
model ProjectImage {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  url       String
  order     Int

  @@map("project_images")
}

// Entidade apoaidor
model Partner {
  id        String    @id @default(cuid())
  tradeName String
  logoUrl   String?
  siteUrl   String?
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("partners")
}
